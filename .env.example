APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

TIMEZONE=
OTP_REGISTRATION_MAX_SENDS_PER_HOUR=5
# OTP bypass: only for OTP_TEST_BYPASS_PHONE in testing/staging/production
OTP_TEST_BYPASS_ENABLED=false
OTP_TEST_BYPASS_CODE=12345
OTP_TEST_BYPASS_PHONE=+966101010101
# Set true to allow bypass in production (requires OTP_TEST_BYPASS_ENABLED=true as well)
OTP_TEST_BYPASS_ALLOW_PRODUCTION=false

# Global OTP bypass: any phone number accepted with this code (testing/staging only). Keep false in production.
OTP_GLOBAL_BYPASS_ENABLED=false
OTP_GLOBAL_BYPASS_CODE=12345

# API password reset: skip real email and use fixed code (never enable in production)
PASSWORD_RESET_EMAIL_TEST_BYPASS_ENABLED=false
PASSWORD_RESET_EMAIL_TEST_BYPASS_CODE=12345

# PostHog product analytics (tenant SPA only — via GET /api/user/posthog-context)
POSTHOG_ENABLED=false
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Server-only; not exposed to clients (Phase 2+)
POSTHOG_PERSONAL_API_KEY=

# Vercel custom domains (shared multi-tenant front-end project)
# Use a scoped token for the team/project; rotate periodically; never commit real values.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_API_BASE=https://api.vercel.com
VERCEL_MAX_DOMAINS_PER_TENANT=5
# Optional project slot cap (Hobby=50). Leave empty to hide free-slot UI and rely on Vercel errors.
VERCEL_MAX_PROJECT_DOMAINS=50
# Comma-separated platform domains that must never be deleted or treated as orphans
VERCEL_PLATFORM_DOMAINS=taearif.com,www.taearif.com,bigrises.com,www.bigrises.com,test.taearif.com,mandhoor.com
# Allow Vercel mutations from non-production environments (staging/local). Default false.
VERCEL_ALLOW_SHARED_PROJECT_MUTATIONS=false
# Identity guard: defaults to VERCEL_PROJECT_ID / VERCEL_TEAM_ID when unset
VERCEL_EXPECTED_PROJECT_ID=
VERCEL_EXPECTED_TEAM_ID=
# HTTP client tuning for Vercel API calls
VERCEL_HTTP_TIMEOUT=30
VERCEL_RETRY_MAX_ATTEMPTS=3
VERCEL_RETRY_BASE_DELAY_MS=500
# Health sync: consecutive failures before active -> failed (Phase 6+)
VERCEL_HEALTH_FAILURE_THRESHOLD=3
VERCEL_HEALTH_FAILURE_GRACE_HOURS=0
# true = require public NS (ns1/ns2.vercel-dns.com) before active
VERCEL_CHECK_NAMESERVERS=true
# true = auto-attach/detach custom domains on the shared Vercel project
VERCEL_AUTO_ATTACH_CUSTOM_DOMAIN=true
# Admin notification email for verified domains
MAIL_ADMIN_ADDRESS=admin@example.com

# Mobile push notifications (server-only credentials)
# Path to Firebase service account JSON, or the JSON string itself
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.taearif.mobile
APNS_ENV=production

# Calling loopback (no Yeastar): second leg dials a local SIP extension.
# Comma-separated tenant IDs. Empty = off. Remove 1430 once Yeastar is connected.
CALLING_LOOPBACK_TENANTS=1430
CALLING_LOOPBACK_DEST=agent_1002
CALLING_LOOPBACK_TRUNK=loopback
CALLING_LOOPBACK_FROM=+966500000002
