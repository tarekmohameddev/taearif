            "role": "customer",
            "text": "24كرتون"
        },
        {
            "role": "customer",
            "text": "البضاعه صارت قدام العمارة"
        },
        {
            "role": "customer",
            "text": "هلا مرحبا وعليكم السلام ورحمة الله وبركاته"
        },
        {
            "role": "customer",
            "text": "العذر والسموحه انشغلت شوي والمصنع"
        },
        {
            "role": "customer",
            "text": "مارد لي خبر لكن الحين اتأكداك منها واردلك"
        },
        {
            "role": "customer",
            "text": "ان شاءالله"
        },
        {
            "role": "customer",
            "text": "كم طول المغسلة"
        },
