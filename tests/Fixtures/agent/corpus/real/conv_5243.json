            "role": "customer",
            "text": "[Audio message]"
        },
        {
            "role": "customer",
            "text": "نفس الشكل لا والله بس في اشكال مقاربه لها"
        },
        {
            "role": "customer",
            "text": "السعر من 10 وصولاً الى 40 على حسب الحجم"
